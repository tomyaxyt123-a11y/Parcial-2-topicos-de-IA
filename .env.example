# =============================================================================
# Certificado Unilasallista - Variables de entorno
# Copie este archivo como `.env` y complete los valores.
# NUNCA versione el archivo `.env` ni suba credenciales al repositorio.
# =============================================================================

# --- Servidor SMTP institucional (Office 365 / Gmail corporativo) -----------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=certificados@lasalle.edu.co
SMTP_PASS=cambiar-esta-clave-por-la-real
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT=30
SMTP_FROM_NAME=Certificados Unilasallista
SMTP_FROM=certificados@lasalle.edu.co

# --- Comportamiento del flujo ------------------------------------------------
UMBRAL_SIMILITUD=90          # % de similitud para considerar duplicado
UMBRAL_ENCABEZADO=85         # % de similitud para mapear encabezados
PROTEGER_PDF=True            # Cifrar el PDF con el número de documento
PDF_PASSWORD=                # Contraseña por defecto si el rol no tiene documento
LIMPIAR_TEMPORALES=True      # Borrar los PDF temporales tras el envío
DIAS_RETENCION=30            # Retención de los registros de trazabilidad

# --- Aplicación ---------------------------------------------------------------
SECRET_KEY=cambiar-en-produccion
PORT=5000
FLASK_DEBUG=False
DB_PATH=instance/certificados.db
MAX_CONTENT_LENGTH=33554432  # 32 MB

# --- Modo demostración -------------------------------------------------------
# SIMULAR_ENVIO=True genera y registra los certificados sin transmitir correos.
SIMULAR_ENVIO=False

# --- Identidad institucional --------------------------------------------------
UNIVERSIDAD=Universidad de La Salle
PROGRAMA=Tópicos de Inteligencia Artificial
COLOR_INSTITUCIONAL=#007A33
COLOR_SECUNDARIO=#0A3D62
CIUDAD=Bogotá D.C.
